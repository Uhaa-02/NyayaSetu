# ------------------------------------------------------------------
# Copy this file to  .env.local  and fill in the values.
# NEVER commit .env.local to GitHub (it is already in .gitignore).
# ------------------------------------------------------------------

# 1) MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
#    Replace <password> and keep the database name (nyayasetu) in the path.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nyayasetu?retryWrites=true&w=majority

# 2) A long random string used to sign login cookies.
#    Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# 3) Password given to ALL demo users created by `npm run seed`.
DEMO_PASSWORD=Demo@1234
#    The one-click demo login buttons use this value too. If you change DEMO_PASSWORD, set the same
#    value here as well (or turn the demo panel off with NEXT_PUBLIC_DEMO_MODE=false).
NEXT_PUBLIC_DEMO_PASSWORD=Demo@1234

# 4) Show the "demo accounts" quick-login panel on /login (set to false for a real deployment).
NEXT_PUBLIC_DEMO_MODE=true

# 5) Secret for the scheduled SLA check (/api/escalate). Vercel Cron sends it automatically
#    as "Authorization: Bearer <CRON_SECRET>". Use any long random string.
CRON_SECRET=change-me-too

# 6) OPTIONAL - run the SLA escalation check automatically whenever the dashboard loads
#    (throttled to once per 5 minutes). Leave false if you want to demo the manual button.
AUTO_ESCALATE=false

# 7) OPTIONAL - enable LLM-assisted classification and summaries (Anthropic API).
#    If empty, the built-in rule-based engine is used (works offline, no cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# 8) OPTIONAL - email alerts through Resend (https://resend.com, free tier). Leave RESEND_API_KEY empty to keep
#    alerts in-app only. Emails go out for: complaint receipt (to the complainant), new/assigned/transferred/
#    escalated cases (to the officer), overlaps (to bureau heads), resolved/closed (to the complainant), and a
#    reminder digest each time the SLA check runs.
RESEND_API_KEY=
#    Resend's test sender below can only deliver to the email address of your own Resend account.
MAIL_FROM=NyayaSetu <onboarding@resend.dev>
#    For demos: send EVERY email to this one address (the seeded staff addresses are fictional).
MAIL_DEMO_TO=
#    Public URL used for links inside emails (Render's URL is detected automatically).
APP_URL=
